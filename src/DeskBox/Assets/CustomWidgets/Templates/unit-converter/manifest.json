        {
          "value": "yd",
          "label": "yd"
        },
        {
          "value": "mi",
          "label": "mi"
        },
        {
          "value": "nmi",
          "label": "nmi"
        }
      ],
      "onChange": {
        "type": "script.run",
        "fn": "recalc"
      }
    },
    "uc_from_mass": {
