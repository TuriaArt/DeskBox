{
  "schemaVersion": 1,
  "id": "deskbox.month-progress",
  "name": "${$i18n.widgetName}",
  "description": "${$i18n.widgetDescription}",
  "icon": "🌗",
  "version": "1.0.0",
  "author": "DeskBox",
  "origin": "official",
  "capabilities": [
    "script-sandbox",
    "visual-containers",
    "micro-charts",
    "forms-inputs",
    "widget-settings",
    "advanced-inputs-and-styling"
  ],
  "minSize": {
    "width": 280,
    "height": 230
  },
  "defaultSize": {
    "width": 320,
    "height": 300
  },
  "settings": [
    {
      "key": "style",
      "type": "choice",
      "label": "${$i18n.setStyle}",
      "default": "ring",
      "options": [
        {
          "value": "ring",
          "label": "${$i18n.optRing}"
        },
        {
          "value": "bar",
          "label": "${$i18n.optBar}"
        }
      ]
    }
  ],
  "state": {},
  "script": {
    "entry": "logic.js",
    "tickIntervalMs": 30000
  },
  "capsule": {
    "title": "${$i18n.widgetName}",
    "summary": "${$computed.capsuleSummary}",
    "glyph": "🌗",
    "badge": "${$computed.pctText}",
    "progress": "${$computed.pct}",
    "primaryAction": {
      "icon": "refresh",
      "tooltip": "${$i18n.tipRefresh}",
      "onClick": {
        "type": "script.run",
        "fn": "refresh"
      }
    }
  },
  "root": "main",
  "elements": {
    "main": {
      "type": "Stack",
      "padding": "12",
      "spacing": 10,
      "children": [
        "mp_summary_card",
        "mp_detail_card"
      ]
    },
    "mp_summary_card": {
      "type": "Card",
      "tone": "subtle",
      "padding": "12,10",
      "spacing": 8,
      "children": [
        "mp_summary_grid"
      ]
    },
    "mp_summary_grid": {
      "type": "Grid",
      "columns": "Auto,*,Auto",
      "columnSpacing": 12,
      "verticalAlignment": "center",
      "children": [
        "mp_ring",
        "mp_bar",
        "mp_info",
        "mp_emoji"
      ]
    },
    "mp_ring": {
      "type": "RadialGauge",
      "column": 0,
      "size": 92,
      "value": "${$computed.pct}",
      "max": 100,
      "color": "blue",
      "startAngle": 135,
      "sweepAngle": 270,
      "thickness": 9,
      "verticalAlignment": "center",
      "children": [
        "mp_ring_icon"
      ],
      "when": "${$computed.useRing}"
    },
    "mp_bar": {
      "type": "ProgressBar",
      "column": 0,
      "width": 92,
      "value": "${$computed.pct}",
      "max": 100,
      "color": "blue",
      "height": 14,
      "verticalAlignment": "center",
      "when": "${$computed.useBar}"
    },
    "mp_info": {
      "type": "Stack",
      "column": 1,
      "spacing": 3,
      "verticalAlignment": "center",
      "children": [
        "mp_pct_big",
        "mp_sub"
      ]
    },
    "mp_pct_big": {
      "type": "Text",
      "text": "${$computed.pctText}",
      "style": "hero",
      "dir": "ltr"
    },
    "mp_sub": {
      "type": "Text",
      "text": "${$i18n.subMonth}",
      "style": "caption",
      "color": "secondary",
      "maxLines": 1
    },
    "mp_emoji": {
      "type": "Text",
      "column": 2,
      "text": "🌗",
      "style": "body",
      "verticalAlignment": "center",
      "when": "${$computed.useBar}"
    },
    "mp_detail_card": {
      "type": "Card",
      "tone": "default",
      "padding": "10,10",
      "spacing": 6,
      "children": [
        "mp_day_row",
        "mp_left_row"
      ]
    },
    "mp_day_row": {
      "type": "Grid",
      "columns": "*,Auto",
      "columnSpacing": 8,
      "children": [
        "mp_day_lbl",
        "mp_day_val"
      ]
    },
    "mp_day_lbl": {
      "type": "Text",
      "column": 0,
      "text": "${$i18n.lblDay}",
      "style": "caption",
      "color": "secondary"
    },
    "mp_day_val": {
      "type": "Text",
      "column": 1,
      "dir": "ltr",
      "text": "${$computed.dayText}",
      "style": "body",
      "fontWeight": "semiBold"
    },
    "mp_left_row": {
      "type": "Grid",
      "columns": "*,Auto",
      "columnSpacing": 8,
      "children": [
        "mp_left_lbl",
        "mp_left_val"
      ]
    },
    "mp_left_lbl": {
      "type": "Text",
      "column": 0,
      "text": "${$i18n.lblLeft}",
      "style": "caption",
      "color": "secondary"
    },
    "mp_left_val": {
      "type": "Text",
      "column": 1,
      "dir": "ltr",
      "text": "${$computed.leftText}",
      "style": "body",
      "fontWeight": "semiBold"
    },
    "mp_ring_icon": {
      "type": "Text",
      "text": "🌗",
      "fontSize": 24,
      "horizontalAlignment": "center",
      "verticalAlignment": "center"
    }
  }
}
